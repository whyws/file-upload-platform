{
  "name": "chunk-upload-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
